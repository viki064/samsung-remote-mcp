# Public Hosted HTTP Server Settings (No Bearer Auth)
MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# Optional Default Fallback TV (when a session has not yet saved its own TV)
SAMSUNG_TV_HOST=
SAMSUNG_TV_PORT=8002
SAMSUNG_TV_MAC=
SAMSUNG_TV_TOKEN=

# Optional SmartThings Cloud API Token (for public cloud hosting)
SMARTTHINGS_TOKEN=
SMARTTHINGS_DEVICE_ID=
