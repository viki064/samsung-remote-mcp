# Public Hosted HTTP Server Settings (No Bearer Auth)
MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# Optional Default Fallback TV (when a session has not yet saved its own TV)
SAMSUNG_TV_HOST=
SAMSUNG_TV_PORT=8002
SAMSUNG_TV_MAC=
SAMSUNG_TV_TOKEN=


# One-word Bearer <redacted> for the MCP HTTP endpoints (optional).
# When set, clients must send: Authorization: Bearer <your-word>
# on POST /mcp, POST /messages and GET /sse. Leave empty for open access.
MCP_AUTH_TOKEN=
